{
  "manifest_version": 3,
  "name": "Google Flow CLI Bridge",
  "version": "1.1.0",
  "description": "Chrome Extension bridge for Google Flow AI image & video automation from CLI and AI agents",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://labs.google/*",
    "*://flow.google.com/*",
    "*://flow-content.google/*",
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*",
    "ws://localhost/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Flow CLI Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://labs.google/fx/*",
        "*://flow.google.com/*"
      ],
      "js": [
        "flow-actions.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
